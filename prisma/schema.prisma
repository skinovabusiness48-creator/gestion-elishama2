generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id
  name        String
  emoji       String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  Product     Product[]
}

model CustomerFeedback {
  id        String   @id
  itemName  String
  itemType  String?
  feedback  String
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model Dish {
  id          String     @id
  name        String
  photo       String?
  price       Float      @default(0)
  description String?
  available   Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  SaleItem    SaleItem[]
}

model Drink {
  id          String     @id
  name        String
  photo       String?
  price       Float      @default(0)
  description String?
  available   Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  SaleItem    SaleItem[]
}

model Expense {
  id              String           @id
  name            String
  amount          Float
  date            DateTime         @default(now())
  description     String?
  photo           String?
  categoryId      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  ExpenseCategory ExpenseCategory? @relation(fields: [categoryId], references: [id])
}

model ExpenseCategory {
  id        String    @id
  name      String
  emoji     String?
  createdAt DateTime  @default(now())
  Expense   Expense[]
}

model Product {
  id            String       @id
  name          String
  categoryId    String?
  photo         String?
  purchasePrice Float        @default(0)
  salePrice     Float        @default(0)
  quantity      Float        @default(0)
  minStock      Float        @default(0)
  unit          String       @default("unité")
  description   String?
  available     Boolean      @default(true)
  internalCode  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime
  Category      Category?    @relation(fields: [categoryId], references: [id])
  SaleItem      SaleItem[]
  StockEntry    StockEntry[]
}

model Sale {
  id          String     @id
  date        DateTime   @default(now())
  totalAmount Float      @default(0)
  note        String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  SaleItem    SaleItem[]
}

model SaleItem {
  id        String   @id
  saleId    String
  itemType  String
  productId String?
  dishId    String?
  drinkId   String?
  itemName  String
  quantity  Float    @default(1)
  unitPrice Float    @default(0)
  total     Float    @default(0)
  Drink     Drink?   @relation(fields: [drinkId], references: [id])
  Dish      Dish?    @relation(fields: [dishId], references: [id])
  Product   Product? @relation(fields: [productId], references: [id])
  Sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model StockEntry {
  id           String    @id
  date         DateTime  @default(now())
  productId    String?
  productName  String
  supplierId   String?
  supplierName String?
  quantity     Float     @default(0)
  unitPrice    Float     @default(0)
  observation  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime
  Supplier     Supplier? @relation(fields: [supplierId], references: [id])
  Product      Product?  @relation(fields: [productId], references: [id])
}

model Supplier {
  id          String       @id
  name        String
  phone       String?
  address     String?
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime
  StockEntry  StockEntry[]
}


